# RECURSION backend configuration. Every value is optional; defaults are in app/config.py.
# All variables are prefixed RECURSION_.

# --- server
RECURSION_HOST=127.0.0.1
RECURSION_PORT=8000
RECURSION_LOG_LEVEL=INFO
# RECURSION_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- persistence (SQLite, WAL mode). data_dir is created if missing.
RECURSION_DATA_DIR=./data
RECURSION_DB_FILENAME=recursion.sqlite3
RECURSION_SNAPSHOT_INTERVAL_TICKS=2400
RECURSION_RETAIN_SNAPSHOTS=48
RECURSION_EVENT_FLUSH_TICKS=50

# --- simulation defaults for new universes (operator settings in the UI override these)
RECURSION_TICK_RATE=24
RECURSION_WORLD_WIDTH=256
RECURSION_WORLD_HEIGHT=160
RECURSION_CELL_SIZE=8
RECURSION_INITIAL_POPULATION=5
RECURSION_HOST_TICK_BUDGET=400
RECURSION_MAX_TICKS_PER_LOOP=200
# Restored universes that were running at shutdown stay paused unless this is true.
RECURSION_AUTOSTART_RESTORED=false

# --- inference (Ollama first; OpenAI-compatible adapters configurable from Settings)
RECURSION_OLLAMA_BASE_URL=http://127.0.0.1:11434
RECURSION_DEFAULT_MODEL=qwen3:4b
RECURSION_INFERENCE_CONCURRENCY=1
RECURSION_INFERENCE_TIMEOUT_S=120
RECURSION_INFERENCE_NUM_CTX=4096
RECURSION_INFERENCE_TEMPERATURE=0.7
# -1 keeps the model resident in VRAM between calls
RECURSION_INFERENCE_KEEP_ALIVE=-1
RECURSION_INFERENCE_THINK_DECISIONS=false
RECURSION_INFERENCE_THINK_REFLECTION=true

# --- cognition cadence (ticks)
RECURSION_MEMORY_WINDOW=24
RECURSION_REFLECTION_INTERVAL=400
RECURSION_DECISION_INTERVAL=120
RECURSION_MIN_DECISION_GAP=20
