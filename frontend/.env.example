# Data source for the frontend.
#   static — read bundled, clearly-labelled sample fixtures (no backend required)
#   http   — call the FastAPI backend over REST and WebSocket
VITE_DATA_SOURCE=static

# REST base URL of the simulation backend. Leave relative to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# WebSocket endpoint for live simulation state. Leave blank to derive from the page origin.
VITE_WS_URL=
